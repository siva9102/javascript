// Display all employees using forEach()
function displayEmployees() {
    console.log("========== ALL EMPLOYEES ==========");

    employees.forEach(function(employee) {
        console.log(
            "ID:", employee.id,
            "| Name:", employee.name,
            "| Department:", employee.department,
            "| Salary:", employee.salary,
            "| Experience:", employee.experience,
            "| Skills:", employee.skills.join(", ")
        );
    });
}

// Find employees whose salary is greater than 40000 using filter()
function filterHighSalaryEmployees() {
    let highSalaryEmployees = employees.filter(function(employee) {
        return employee.salary > 40000;
    });

    console.log("========== SALARY ABOVE 40000 ==========");

    highSalaryEmployees.forEach(function(employee) {
        console.log(employee);
    });
}

// Search employee by ID using find()
function searchEmployee(id) {
    let employee = employees.find(function(employee) {
        return employee.id === id;
    });

    if (employee) {
        console.log("========== EMPLOYEE FOUND ==========");
        console.log(employee);
        return employee;
    } else {
        console.log("Employee not found");
        return null;
    }
}

// Calculate total salary using reduce()
function calculateTotalSalary() {
    let totalSalary = employees.reduce(function(total, employee) {
        return total + employee.salary;
    }, 0);

    console.log("Total Salary:", totalSalary);

    return totalSalary;
}

// Check whether at least one employee earns above 100000 using some()
function checkHighSalaryCondition() {
    let result = employees.some(function(employee) {
        return employee.salary > 100000;
    });

    console.log("At least one employee has salary above 100000:", result);

    return result;
}

// Check whether every employee has at least 1 year experience using every()
function checkExperience() {
    let result = employees.every(function(employee) {
        return employee.experience >= 1;
    });

    console.log("Every employee has at least 1 year experience:", result);

    return result;
}

// Sort employees by salary from highest to lowest
function sortEmployeesBySalary() {
    let sortedEmployees = [...employees];

    sortedEmployees.sort(function(a, b) {
        return b.salary - a.salary;
    });

    console.log("========== SORTED BY SALARY ==========");

    sortedEmployees.forEach(function(employee) {
        console.log(employee.name, "₹" + employee.salary);
    });

    return sortedEmployees;
}

// Add employee using push()
function addEmployee(employee) {
    employees.push(employee);

    console.log("Employee added successfully:", employee.name);
}

// Delete last employee using pop()
function deleteLastEmployee() {
    let deletedEmployee = employees.pop();

    console.log("Last employee removed:", deletedEmployee.name);
}

// Add employee at beginning using unshift()
function addEmployeeAtBeginning(employee) {
    employees.unshift(employee);

    console.log("Employee added at beginning:", employee.name);
}

// Remove first employee using shift()
function deleteFirstEmployee() {
    let deletedEmployee = employees.shift();

    console.log("First employee removed:", deletedEmployee.name);
}

// Object destructuring
function demonstrateObjectDestructuring(employee) {
    let {
        name,
        department,
        salary
    } = employee;

    console.log("========== OBJECT DESTRUCTURING ==========");
    console.log("Name:", name);
    console.log("Department:", department);
    console.log("Salary:", salary);
}

// Array destructuring
function demonstrateArrayDestructuring(employee) {
    let [skill1, skill2, skill3] = employee.skills;

    console.log("========== ARRAY DESTRUCTURING ==========");
    console.log("Skill 1:", skill1);
    console.log("Skill 2:", skill2);
    console.log("Skill 3:", skill3);
}

// Spread operator creates a new employee array
function demonstrateSpreadOperator() {
    let newEmployeeArray = [...employees];

    console.log("Original array:", employees);
    console.log("New array using spread:", newEmployeeArray);

    return newEmployeeArray;
}

// Rest operator accepts employee name and multiple skills
function addSkills(employeeName, ...skills) {
    console.log("========== REST OPERATOR ==========");
    console.log("Employee Name:", employeeName);
    console.log("Skills:", skills);
}

// Determine salary category
function salaryCategory(salary) {
    if (salary <= 30000) {
        return "Junior";
    } else if (salary <= 60000) {
        return "Mid Level";
    } else {
        return "Senior";
    }
}

// Display salary category for all employees
function displaySalaryCategories() {
    console.log("========== SALARY CATEGORIES ==========");

    employees.forEach(function(employee) {
        console.log(
            employee.name,
            "₹" + employee.salary,
            "->",
            salaryCategory(employee.salary)
        );
    });
}

// Display joining year and month using Date methods
function displayJoiningDateDetails() {
    console.log("========== JOINING DATE DETAILS ==========");

    employees.forEach(function(employee) {
        let date = new Date(employee.joiningDate);

        console.log(
            employee.name,
            "Joining Year:",
            date.getFullYear(),
            "Joining Month:",
            date.getMonth() + 1
        );
    });
}

// Add employee function
function addNewEmployee() {
    let newEmployee = {
        id: 109,
        name: "Ravi",
        department: "IT",
        salary: 60000,
        experience: 3,
        skills: ["JavaScript", "React", "MongoDB"],
        joiningDate: "2024-05-10"
    };

    employees.push(newEmployee);

    console.log("New employee added:", newEmployee);
}

// Delete employee using ID
function deleteEmployee(id) {
    let index = employees.findIndex(function(employee) {
        return employee.id === id;
    });

    if (index !== -1) {
        let deletedEmployee = employees.splice(index, 1);

        console.log("Employee deleted:", deletedEmployee[0]);
    } else {
        console.log("Employee not found");
    }
}

// User input using prompt()
function searchEmployeeUsingPrompt() {
    let employeeId = Number(prompt("Enter Employee ID:"));

    let employee = employees.find(function(employee) {
        return employee.id === employeeId;
    });

    if (employee) {
        console.log("========== SEARCH RESULT ==========");
        console.log("ID:", employee.id);
        console.log("Name:", employee.name);
        console.log("Department:", employee.department);
        console.log("Salary:", employee.salary);
        console.log("Experience:", employee.experience);
        console.log("Skills:", employee.skills.join(", "));
        console.log("Joining Date:", employee.joiningDate);
    } else {
        console.log("Employee not found");
    }
}

// Menu-driven Employee Management System
function employeeManagementSystem() {
    let choice;

    do {
        choice = prompt(
            "EMPLOYEE MANAGEMENT SYSTEM\n\n" +
            "1. Display All Employees\n" +
            "2. Add Employee\n" +
            "3. Search Employee\n" +
            "4. Filter High Salary Employees\n" +
            "5. Calculate Total Salary\n" +
            "6. Sort By Salary\n" +
            "7. Delete Employee\n" +
            "8. Exit\n\n" +
            "Enter your choice:"
        );

        switch (choice) {

            case "1":
                displayEmployees();
                break;

            case "2":
                addNewEmployee();
                break;

            case "3":
                searchEmployeeUsingPrompt();
                break;

            case "4":
                filterHighSalaryEmployees();
                break;

            case "5":
                calculateTotalSalary();
                break;

            case "6":
                sortEmployeesBySalary();
                break;

            case "7":
                let deleteId = Number(prompt("Enter Employee ID to delete:"));
                deleteEmployee(deleteId);
                break;

            case "8":
                console.log("Exiting Employee Management System...");
                break;

            default:
                console.log("Invalid choice. Please enter 1 to 8.");
        }

    } while (choice !== "8");
}

