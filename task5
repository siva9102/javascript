// Level 6 - Higher-Order Functions

// Task 16 - Employee Salary Filter
let employees = [
    { name: "Arun", salary: 30000 },
    { name: "Bala", salary: 50000 },
    { name: "Kumar", salary: 25000 },
    { name: "Ravi", salary: 70000 }
];

let highSalaryEmployees = employees.filter(function (employee) {
    return employee.salary >= 40000;
});

console.log(highSalaryEmployees);


// Task 17 - Increase Salary
let increasedSalaries = employees.map(function (employee) {
    if (employee.salary < 40000) {
        return {
            ...employee,
            salary: employee.salary + 5000
        };
    } else {
        return {
            ...employee,
            salary: employee.salary + 10000
        };
    }
});

console.log(increasedSalaries);


// Task 18 - Total Salary
let totalSalary = employees.reduce(function (total, employee) {
    return total + employee.salary;
}, 0);

console.log("Total Salary: ₹" + totalSalary);


// Task 19 - Check Employee
let earnsAbove100000 = employees.some(function (employee) {
    return employee.salary > 100000;
});

let allEarnAtLeast20000 = employees.every(function (employee) {
    return employee.salary >= 20000;
});

console.log("Anyone earning above ₹100000: " + earnsAbove100000);
console.log("Everyone earning at least ₹20000: " + allEarnAtLeast20000);


