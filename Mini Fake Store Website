<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fake Store</title>
    style.css
</head>
<body>

    <h1>🛒 FAKE STORE</h1>

    <div class="search-box">
        <input type="text" id="searchInput" placeholder="Search Product">
        <button id="searchBtn">Search</button>
    </div>

    <div id="categoryButtons">
        <button onclick="filterCategory('all')">All</button>
        <button onclick="filterCategory(`men's clothing`)">Men</button>
        <button onclick="filterCategory(`women's clothing`)">Women</button>
        <button onclick="filterCategory('jewelery')">Jewellery</button>
        <button onclick="filterCategory('electronics')">Electronics</button>
    </div>

    <div class="sort-buttons">
        <button id="lowHigh">Low → High</button>
        <button id="highLow">High → Low</button>
    </div>

    <h2 id="totalProducts">Total Products: 0</h2>

    <h3 id="cart">🛒 Cart (0)</h3>

    <div class="apicard"></div>

    script.jsscript>

</body>
</html>

@@@@@@@@@@@@@2 CSS @@@@@@@@@@@@@@
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    padding:20px;
    background:#f4f4f4;
}

h1{
    text-align:center;
    margin-bottom:20px;
}

.search-box{
    text-align:center;
    margin-bottom:20px;
}

.search-box input{
    padding:10px;
    width:250px;
}

.search-box button{
    padding:10px 15px;
}

#categoryButtons,
.sort-buttons{
    text-align:center;
    margin:15px 0;
}

#categoryButtons button,
.sort-buttons button{
    padding:10px 15px;
    margin:5px;
    cursor:pointer;
}

#totalProducts{
    text-align:center;
    margin-bottom:20px;
}

#cart{
    text-align:center;
    color:green;
    margin-bottom:20px;
}

.apicard{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
}

.card{
    background:white;
    border-radius:10px;
    padding:15px;
    box-shadow:0 0 10px rgba(0,0,0,0.1);
    text-align:center;
}

.card img{
    width:150px;
    height:150px;
    object-fit:contain;
}

.card h3{
    margin:10px 0;
    font-size:18px;
}

.card p{
    font-size:14px;
}

.price{
    color:green;
    font-weight:bold;
    margin:10px 0;
}

.card button{
    background:blue;
    color:white;
    border:none;
    padding:10px;
    cursor:pointer;
    border-radius:5px;
}

@@@@@@@@@@@  JAVA SCRIPT @@@@@@@@@@@@@@@@@
const apiCard = document.querySelector(".apicard");
const totalProducts = document.getElementById("totalProducts");

let allProducts = [];
let cartCount = 0;

// Fetch API
fetch("https://fakestoreapi.com/products")
.then(response => response.json())
.then(data => {

    allProducts = data;

    totalProducts.innerText =
        `Total Products: ${data.length}`;

    displayProducts(data);

});

// Display Products
function displayProducts(products){

    apiCard.innerHTML = "";

    if(products.length === 0){
        apiCard.innerHTML = "<h2>No Products Found</h2>";
        return;
    }

    products.forEach(product => {

        const card = document.createElement("div");
        card.classList.add("card");

        card.innerHTML = `
            <imgoduct.image}
            <h3>${product.title}</h3>
            <h4>${product.category}</h4>
            <p>${product.description.slice(0,100)}...</p>
            <div class="price">$${product.price}</div>
            <button onclick="addToCart()">
                Add to Cart
            </button>
        `;

        apiCard.appendChild(card);

    });

}

// Search Product
document
.getElementById("searchBtn")
.addEventListener("click", () => {

    const value =
    document
    .getElementById("searchInput")
    .value
    .toLowerCase();

    const result = allProducts.filter(product =>
        product.title
        .toLowerCase()
        .includes(value)
    );

    displayProducts(result);

});

// Category Filter
function filterCategory(category){

    if(category === "all"){
        displayProducts(allProducts);
        return;
    }

    const result = allProducts.filter(product =>
        product.category === category
    );

    displayProducts(result);

}

// Sort Low to High
document
.getElementById("lowHigh")
.addEventListener("click", () => {

    const sorted =
    [...allProducts].sort(
        (a,b) => a.price - b.price
    );

    displayProducts(sorted);

});

// Sort High to Low
document
.getElementById("highLow")
.addEventListener("click", () => {

    const sorted =
    [...allProducts].sort(
        (a,b) => b.price - a.price
    );

    displayProducts(sorted);

});

// Add To Cart
function addToCart(){

    cartCount++;

    document.getElementById("cart").innerText =
    `🛒 Cart (${cartCount})`;

}



